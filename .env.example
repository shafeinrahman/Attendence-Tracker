# Database connection string (Postgres)
# Local Docker default:
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance_tracker?schema=public"

# Inside Docker Compose network (used by docker-compose):
# DATABASE_URL="postgresql://attendance:attendance@db:5432/attendance_tracker?schema=public"

# Auth API Token / PIN for single-user authentication
API_TOKEN="attendance-secret-token-12345"

# Web Port
PORT=3000
